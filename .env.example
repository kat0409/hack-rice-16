# Copy to .env and fill in. Never commit .env (see design-doc.md §16.1/§16.3).

# --- Database container (docker-compose.yml / graphite-db) ---
POSTGRES_USER=graphite
POSTGRES_PASSWORD=graphite
POSTGRES_DB=graphite
POSTGRES_PORT=5432

# Must be frozen before the schema is created against real data — see
# design-doc.md §8.5 and §17 ("pgvector dimension mismatch" is a P0 risk).
#
# 384 is the output width of EMBEDDING_MODEL below (BAAI/bge-small-en-v1.5,
# run locally via fastembed — no API key, no network). It is baked into the
# vector(N) columns by graphite-db/init/10_run_schema.sh at container init, which
# only runs against an empty volume. Changing this later therefore requires
# `make db-reset` and a full re-embed, not a migration. Change the model and this
# number together or not at all.
EMBEDDING_DIMENSIONS=384

# --- Application (design-doc.md §16.1 "Expected environment variables") ---
DATABASE_URL=postgresql://graphite:graphite@localhost:5432/graphite
# Extraction LLM. Gemini is the single external model provider
# (design-doc.md §6.6: "The model provider is accessed through one internal adapter").
GEMINI_API_KEY=
# Pinned from what your key actually serves — list the models once rather than
# guessing an id. Recorded in job metadata for reproducibility (§15.4).
GEMINI_MODEL=
# Embeddings run LOCALLY via fastembed — no API key and no network at inference,
# which keeps chunk text inside the local-first boundary of design-doc.md §8.11.
# Its output width must equal EMBEDDING_DIMENSIONS above.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
UPLOAD_DIR=./data/uploads
